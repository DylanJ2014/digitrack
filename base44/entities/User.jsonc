{
  "name": "User",
  "type": "object",
  "properties": {
    "user_type": {
      "type": "string",
      "enum": [
        "student",
        "parent",
        "staff"
      ],
      "description": "Type of user account"
    },
    "display_name": {
      "type": "string",
      "description": "User's display name"
    },
    "school": {
      "type": "string",
      "enum": [
        "Pre-Prep",
        "Prep",
        "Senior School"
      ],
      "description": "School (for students)"
    },
    "form_group": {
      "type": "string",
      "description": "Form group (for students)"
    },
    "house": {
      "type": "string",
      "enum": [
        "Viewpoint",
        "Foxburrow",
        "Pilgrims",
        "Underwood",
        "Lewisham",
        "Aldercombe",
        "Newington",
        "Harestone",
        "Ridgefield",
        "Beech Hanger",
        "Townsend/Viney"
      ],
      "description": "House (for students)"
    },
    "child_name": {
      "type": "string",
      "description": "Child's full name (for parents)"
    },
    "child_form_group": {
      "type": "string",
      "description": "Child's form group (for parents)"
    },
    "staff_role": {
      "type": "string",
      "description": "Staff role (for staff members)"
    },
    "is_registered": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has completed registration"
    }
  },
  "required": [
    "user_type"
  ]
}